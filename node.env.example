# =============================================================================
# TwoLink VPN — remote pico-node environment template
# Copy to node.env on the node's host and fill in real values.
# Never commit node.env.
# =============================================================================

TZ=UTC

# --- Xray node ---
XRAY_VLESS_PORT=443
XRAY_SS_PORT=8388
# Xray gRPC management API — internal docker network only (node-agent's own
# network), never published to the node's host or the internet.
XRAY_API_PORT=10085

# Reality settings — generate locally via `xray x25519`, never hardcode/commit.
REALITY_PRIVATE_KEY=changeme_generate_with_xray_x25519
REALITY_SHORT_ID=changeme_generate_short_id
REALITY_DEST=www.microsoft.com:443
REALITY_SERVER_NAMES=www.microsoft.com

SHADOWSOCKS_METHOD=chacha20-ietf-poly1305
SHADOWSOCKS_PASSWORD=changeme_generate_a_strong_random_password

# --- node-agent ---
# This node's own secret. Generate once (e.g. `openssl rand -base64 32`),
# give it to the main server operator out-of-band, and register only its
# SHA-256 hash in the main server's database — never the plaintext.
NODE_API_KEY=changeme_generate_with_openssl_rand

# Comma-separated IP(s) of the main server. Defense-in-depth alongside the
# API key and the host firewall rule restricting this port to that IP.
ALLOWED_BACKEND_IPS=changeme_main_server_ip

# Host port node-agent listens on (only reachable from ALLOWED_BACKEND_IPS
# once the node's firewall is configured — see README).
NODE_AGENT_PORT=8443
