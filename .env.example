# =============================================================================
# TwoLink VPN — environment configuration template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- General ---
ENVIRONMENT=development          # development | production
TZ=UTC

# --- PostgreSQL ---
POSTGRES_USER=twolink
POSTGRES_PASSWORD=changeme_generate_a_strong_random_password
POSTGRES_DB=twolink
POSTGRES_HOST=postgres           # docker service name, internal network only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_INTERNAL_API_KEY=changeme_generate_with_secrets_token_urlsafe
# Base URL used to build subscription links returned to users
PUBLIC_BASE_URL=http://localhost:8000
# How the bot (and other internal-only callers) reach the backend inside the docker network
BACKEND_INTERNAL_URL=http://backend:8000

# --- Telegram Bot ---
BOT_TOKEN=changeme_telegram_bot_token
# Optional: set only if bot runs in webhook mode
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# --- Xray node (this VM/VPS) ---
# node_id must match a row in the "nodes" table so the backend
# knows which server this config belongs to.
NODE_ID=node-local-dev
NODE_HOST=127.0.0.1
XRAY_VLESS_PORT=443
XRAY_SS_PORT=8388
# Xray gRPC management API — internal docker network only, never published to host
XRAY_API_PORT=10085

# Reality settings — private/public keys generated locally via `xray x25519`,
# never hardcoded, never committed.
REALITY_PRIVATE_KEY=changeme_generate_with_xray_x25519
REALITY_PUBLIC_KEY=changeme_generate_with_xray_x25519
REALITY_SHORT_ID=changeme_generate_short_id
REALITY_DEST=www.microsoft.com:443
REALITY_SERVER_NAMES=www.microsoft.com

# Shadowsocks (reserve protocol)
SHADOWSOCKS_METHOD=chacha20-ietf-poly1305
SHADOWSOCKS_PASSWORD=changeme_generate_a_strong_random_password

# Hysteria2 (QUIC/UDP, alternative protocol alongside VLESS+Reality)
HYSTERIA_PORT=443
HYSTERIA_OBFS_PASSWORD=changeme_generate_a_strong_random_password

# --- Remote pico-nodes' node-agent API keys ---
# Format: node_id:key,node_id2:key2 — plaintext keys, generated per node.
# The database only ever stores their SHA-256 hash (Node.api_key_hash).
NODE_AGENT_API_KEYS=

# --- WireGuard (optional profile) ---
WG_PRIVATE_KEY=
WG_PUBLIC_KEY=
WG_PORT=51820

# --- Payment providers (stubs on local dev, real keys only in prod .env) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
CRYPTOBOT_TOKEN=

# --- Monitoring (optional profile) ---
GRAFANA_ADMIN_PASSWORD=changeme_generate_a_strong_random_password
